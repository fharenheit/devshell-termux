From abb3d3628adb6527962b23511e38155508dbebd6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 12:38:29 +0000
Subject: [PATCH] Added: Show new output and bells of background sessions on
 their tabs

Tabs of sessions that are not displayed show a dot when the session had
output and a bell when it rang the bell since it was last displayed.
These are also recorded while the activity is stopped or destroyed, as
TermuxService now gives sessions a client that records them when no
activity is bound. Toasts for switching sessions and for title changes
of other sessions are not shown anymore, since the tabs show them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GLNsTPnn2xKUQ4uFcevT6G
---
 .../main/java/com/termux/app/TermuxActivity.java   | 10 ++++++++++
 .../main/java/com/termux/app/TermuxService.java    |  3 ++-
 .../app/terminal/TermuxTerminalSessionClient.java  | 14 +++++++++++---
 3 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/com/termux/app/TermuxActivity.java b/app/src/main/java/com/termux/app/TermuxActivity.java
index 414277d..9f1d444 100644
--- a/app/src/main/java/com/termux/app/TermuxActivity.java
+++ b/app/src/main/java/com/termux/app/TermuxActivity.java
@@ -800,6 +800,16 @@ public final class TermuxActivity extends Activity implements ServiceConnection
             mTerminalTabsController.refresh();
     }
 
+    @Nullable
+    public TerminalTabsController getTerminalTabsController() {
+        return mTerminalTabsController;
+    }
+
+    /** Whether the terminal tabs show the sessions, their titles and states, so toasts for them are not needed. */
+    public boolean areTerminalTabsShown() {
+        return mTerminalTabsController != null;
+    }
+
     public boolean isVisible() {
         return mIsVisible;
     }
diff --git a/app/src/main/java/com/termux/app/TermuxService.java b/app/src/main/java/com/termux/app/TermuxService.java
index f7034e2..3e87fc2 100644
--- a/app/src/main/java/com/termux/app/TermuxService.java
+++ b/app/src/main/java/com/termux/app/TermuxService.java
@@ -24,6 +24,7 @@ import androidx.annotation.Nullable;
 import com.termux.R;
 import com.termux.app.settings.properties.TermuxAppSharedProperties;
 import com.termux.app.terminal.TermuxTerminalSessionClient;
+import com.termux.app.terminal.tabs.TrackingTerminalSessionClient;
 import com.termux.app.utils.PluginUtils;
 import com.termux.shared.data.IntentUtils;
 import com.termux.shared.models.errors.Errno;
@@ -102,7 +103,7 @@ public final class TermuxService extends Service implements TermuxTask.TermuxTas
     /** The basic implementation of the {@link TerminalSessionClient} interface to be used by {@link TerminalSession}
      * that does not hold activity references.
      */
-    final TermuxTerminalSessionClientBase mTermuxTerminalSessionClientBase = new TermuxTerminalSessionClientBase();
+    final TermuxTerminalSessionClientBase mTermuxTerminalSessionClientBase = new TrackingTerminalSessionClient();
 
     /** The wake lock and wifi lock are always acquired and released together. */
     private PowerManager.WakeLock mWakeLock;
diff --git a/app/src/main/java/com/termux/app/terminal/TermuxTerminalSessionClient.java b/app/src/main/java/com/termux/app/terminal/TermuxTerminalSessionClient.java
index 96225ba..b92cd19 100644
--- a/app/src/main/java/com/termux/app/terminal/TermuxTerminalSessionClient.java
+++ b/app/src/main/java/com/termux/app/terminal/TermuxTerminalSessionClient.java
@@ -17,6 +17,7 @@ import com.termux.shared.shell.TermuxSession;
 import com.termux.shared.interact.TextInputDialogUtils;
 import com.termux.shared.interact.ShareUtils;
 import com.termux.app.TermuxActivity;
+import com.termux.app.terminal.tabs.TerminalTabStates;
 import com.termux.app.terminal.tabs.TerminalTabsController;
 import com.termux.shared.terminal.TermuxTerminalSessionClientBase;
 import com.termux.shared.termux.TermuxConstants;
@@ -116,6 +117,9 @@ public class TermuxTerminalSessionClient extends TermuxTerminalSessionClientBase
 
     @Override
     public void onTextChanged(TerminalSession changedSession) {
+        // Also record output of other sessions while the activity is not visible, to show on their tabs.
+        if (changedSession != mActivity.getCurrentSession()) TerminalTabStates.markOutput(changedSession);
+
         if (!mActivity.isVisible()) return;
 
         if (mActivity.getCurrentSession() == changedSession) mActivity.getTerminalView().onScreenUpdated();
@@ -125,7 +129,7 @@ public class TermuxTerminalSessionClient extends TermuxTerminalSessionClientBase
     public void onTitleChanged(TerminalSession updatedSession) {
         if (!mActivity.isVisible()) return;
 
-        if (updatedSession != mActivity.getCurrentSession()) {
+        if (updatedSession != mActivity.getCurrentSession() && !mActivity.areTerminalTabsShown()) {
             // Only show toast for other sessions than the current one, since the user
             // probably consciously caused the title change to change in the current session
             // and don't want an annoying toast for that.
@@ -207,6 +211,8 @@ public class TermuxTerminalSessionClient extends TermuxTerminalSessionClientBase
 
     @Override
     public void onBell(TerminalSession session) {
+        if (session != mActivity.getCurrentSession()) TerminalTabStates.markBell(session);
+
         if (!mActivity.isVisible()) return;
 
         switch (mActivity.getProperties().getBellBehaviour()) {
@@ -294,14 +300,16 @@ public class TermuxTerminalSessionClient extends TermuxTerminalSessionClientBase
         // We call the following even when the session is already being displayed since config may
         // be stale, like current session not selected or scrolled to.
         checkAndScrollToSession(session);
-        mActivity.terminalTabsNotifyUpdated();
+        TerminalTabsController terminalTabsController = mActivity.getTerminalTabsController();
+        if (terminalTabsController != null)
+            terminalTabsController.onCurrentSessionChanged(session);
         updateBackgroundColor();
     }
 
     void notifyOfSessionChange() {
         if (!mActivity.isVisible()) return;
 
-        if (!mActivity.getProperties().areTerminalSessionChangeToastsDisabled()) {
+        if (!mActivity.getProperties().areTerminalSessionChangeToastsDisabled() && !mActivity.areTerminalTabsShown()) {
             TerminalSession session = mActivity.getCurrentSession();
             mActivity.showToast(toToastTitle(session), false);
         }
