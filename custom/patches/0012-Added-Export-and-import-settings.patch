From e3fb9c5367cbe40884c18e5096df9e7b7dfee58e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 01:03:47 +0000
Subject: [PATCH] Added: Export and import settings

Export settings in the terminal tab bar menu saves a zip file to the
Download directory with termux.properties, colors.properties, the SSH
hosts, the main app preferences like the font size, and the font: the
id of a font of the font list or a custom font.ttf. Saved SSH passwords
are left out, since their Android Keystore key can't leave the device.

Import settings opens the zip file with the system file picker. Only
known entries are read, with size limits. The current files are copied
to ~/.termux/backup/settings-<time>/ first, the SSH hosts are written
to ~/.ssh/termux_hosts again, a font of the font list is applied like
when chosen, and the activity is recreated to load the settings.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GLNsTPnn2xKUQ4uFcevT6G
---
 app/src/main/java/com/termux/app/TermuxActivity.java | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/app/src/main/java/com/termux/app/TermuxActivity.java b/app/src/main/java/com/termux/app/TermuxActivity.java
index 8d1adc4f..73720522 100644
--- a/app/src/main/java/com/termux/app/TermuxActivity.java
+++ b/app/src/main/java/com/termux/app/TermuxActivity.java
@@ -41,6 +41,7 @@ import com.termux.app.activities.HelpActivity;
 import com.termux.app.activities.SettingsActivity;
 import com.termux.shared.settings.preferences.TermuxAppSharedPreferences;
 import com.termux.app.terminal.TermuxSessionsListViewController;
+import com.termux.app.terminal.backup.SettingsBackup;
 import com.termux.app.terminal.tabs.TerminalSessionNotifications;
 import com.termux.app.terminal.tabs.TerminalTabsController;
 import com.termux.app.terminal.io.TerminalToolbarViewPager;
@@ -264,6 +265,13 @@ public final class TermuxActivity extends Activity implements ServiceConnection
         TermuxUtils.sendTermuxOpenedBroadcast(this);
     }
 
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        // The file picker of importing settings from the terminal tabs menu.
+        if (SettingsBackup.onActivityResult(this, requestCode, resultCode, data)) return;
+        super.onActivityResult(requestCode, resultCode, data);
+    }
+
     @Override
     protected void onNewIntent(Intent intent) {
         super.onNewIntent(intent);
