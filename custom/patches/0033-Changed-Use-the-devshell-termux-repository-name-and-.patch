From af4f1e0c2b308118769eaa88c3d3359bf1bde7bd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 01:17:35 +0000
Subject: [PATCH] Changed: Use the devshell-termux repository name and devshell
 APK names

The repository is going to be renamed to fharenheit/devshell-termux.
The links of the app, the font downloads and the documents use the
new name, and the APKs are named devshell_<version>_<abi>.apk.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01GLNsTPnn2xKUQ4uFcevT6G
---
 .github/workflows/attach_debug_apks_to_release.yml | 2 +-
 .github/workflows/debug_build.yml                  | 2 +-
 README.md                                          | 2 +-
 app/build.gradle                                   | 4 ++--
 4 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/attach_debug_apks_to_release.yml b/.github/workflows/attach_debug_apks_to_release.yml
index abb57a1..f1935bb 100644
--- a/.github/workflows/attach_debug_apks_to_release.yml
+++ b/.github/workflows/attach_debug_apks_to_release.yml
@@ -35,7 +35,7 @@ jobs:
 
           APK_DIR_PATH="./app/build/outputs/apk/debug"
           APK_VERSION_TAG="$RELEASE_VERSION_NAME+github-debug"
-          APK_BASENAME_PREFIX="termux-app_$APK_VERSION_TAG"
+          APK_BASENAME_PREFIX="devshell_$APK_VERSION_TAG"
 
           echo "Building APKs for '$RELEASE_VERSION_NAME' release"
           export TERMUX_APK_VERSION_TAG="$APK_VERSION_TAG" # Used by app/build.gradle
diff --git a/.github/workflows/debug_build.yml b/.github/workflows/debug_build.yml
index a4906e1..4d53c37 100644
--- a/.github/workflows/debug_build.yml
+++ b/.github/workflows/debug_build.yml
@@ -32,7 +32,7 @@ jobs:
 
           APK_DIR_PATH="./app/build/outputs/apk/debug"
           APK_VERSION_TAG="$RELEASE_VERSION_NAME-github-debug" # Note the "-", GITHUB_SHA will already have "+" before it
-          APK_BASENAME_PREFIX="termux-app_$APK_VERSION_TAG"
+          APK_BASENAME_PREFIX="devshell_$APK_VERSION_TAG"
 
           # Used by attachment steps later
           echo "APK_DIR_PATH=$APK_DIR_PATH" >> $GITHUB_ENV
diff --git a/README.md b/README.md
index 67c7ab1..f765c09 100644
--- a/README.md
+++ b/README.md
@@ -4,7 +4,7 @@
 >
 > *DevShell is a Termux fork that fixes hardware-keyboard input for languages composed by the IME, such as Korean, Japanese and Chinese, and adds SSH management, a file browser, keyboard shortcuts, snippets and more.*
 >
-> [릴리즈](https://github.com/fharenheit/termux-app/releases)에서 APK를 받아 수동으로 설치하세요(대부분의 기기는 `*_arm64-v8a.apk`). Play 스토어/F-Droid 버전 위에는 덮어 설치할 수 없습니다.
+> [릴리즈](https://github.com/fharenheit/devshell-termux/releases)에서 APK를 받아 수동으로 설치하세요(대부분의 기기는 `*_arm64-v8a.apk`). Play 스토어/F-Droid 버전 위에는 덮어 설치할 수 없습니다.
 >
 > - 입력: 블루투스·하드웨어 키보드로 한국어·일본어·중국어 등 조합 입력, 키캡 모양 하단 키, 특수 키 패널(Ctrl·Fn·tmux·vim 키), 키보드 단축키
 > - 화면: 앱 언어 선택(한국어, English, 日本語, 中文), 글꼴 목록과 미리보기, 탭별 글자 크기, 출력에서 찾기, URL 열기
diff --git a/app/build.gradle b/app/build.gradle
index 386c568..cf2f2d5 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -114,10 +114,10 @@ android {
         variant.outputs.all { output ->
             if (variant.buildType.name == "debug") {
                 def abi = output.getFilter(com.android.build.OutputFile.ABI)
-                outputFileName = new File("termux-app_" + (apkVersionTag ? apkVersionTag : "debug") + "_" + (abi ? abi : "universal") + ".apk")
+                outputFileName = new File("devshell_" + (apkVersionTag ? apkVersionTag : "debug") + "_" + (abi ? abi : "universal") + ".apk")
             } else if (variant.buildType.name == "release") {
                 def abi = output.getFilter(com.android.build.OutputFile.ABI)
-                outputFileName = new File("termux-app_" + (apkVersionTag ? apkVersionTag : "release") + "_" + (abi ? abi : "universal") + ".apk")
+                outputFileName = new File("devshell_" + (apkVersionTag ? apkVersionTag : "release") + "_" + (abi ? abi : "universal") + ".apk")
             }
         }
     }
-- 
2.43.0

