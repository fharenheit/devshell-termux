Subject: [PATCH] Fixed: Reject stale IME input after connection changes

---
 .../view/TerminalInputConnectionTest.java     | 241 ++++++++++++++++++
 .../termux/view/TerminalInputConnection.java  |  16 +-
 .../java/com/termux/view/TerminalView.java    |  13 +-
 3 files changed, 264 insertions(+), 6 deletions(-)

diff --git a/app/src/test/java/com/termux/view/TerminalInputConnectionTest.java b/app/src/test/java/com/termux/view/TerminalInputConnectionTest.java
index a8678ddc..93e5f2e3 100644
--- a/app/src/test/java/com/termux/view/TerminalInputConnectionTest.java
+++ b/app/src/test/java/com/termux/view/TerminalInputConnectionTest.java
@@ -1,5 +1,6 @@
 package com.termux.view;
 
+import android.content.res.Configuration;
 import android.os.Build;
 import android.view.KeyEvent;
 import android.view.inputmethod.EditorInfo;
@@ -13,9 +14,11 @@ import org.junit.Assert;
 import org.junit.Before;
 import org.junit.Test;
 import org.junit.runner.RunWith;
