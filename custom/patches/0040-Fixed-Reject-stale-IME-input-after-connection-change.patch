From eedd7ca6b3e263245c2880557c9b14cbf7a58239 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=EA=B9=80=EB=B3=91=EA=B3=A4?= <fharenheit@gmail.com>
Date: Tue, 20 Oct 2026 23:43:35 +0900
Subject: [PATCH] Fixed: Reject stale IME input after connection changes

---
 .../com/termux/view/TerminalInputConnection.java | 16 ++++++++++++++--
 .../main/java/com/termux/view/TerminalView.java  | 13 +++++++++----
 2 files changed, 23 insertions(+), 6 deletions(-)

diff --git a/terminal-view/src/main/java/com/termux/view/TerminalInputConnection.java b/terminal-view/src/main/java/com/termux/view/TerminalInputConnection.java
index 1d8b0191..196e2218 100644
--- a/terminal-view/src/main/java/com/termux/view/TerminalInputConnection.java
+++ b/terminal-view/src/main/java/com/termux/view/TerminalInputConnection.java
@@ -29,6 +29,8 @@ final class TerminalInputConnection extends BaseInputConnection {
     /** The {@link TerminalView#mInputConnectionGeneration} this connection was created in. */
     private final int mGeneration;
 
+    private boolean mClosed;
+
     /** The committed text sent to the terminal, which is the editable text without the composing text. */
     private String mSent = "";
 
@@ -40,7 +42,7 @@ final class TerminalInputConnection extends BaseInputConnection {
 
     /** Whether text the IME sends should be dropped, since input was started again after this connection was created. */
     private boolean isDiscarded() {
-        if (mGeneration == mView.mInputConnectionGeneration) return false;
+        if (!mClosed && mGeneration == mView.mInputConnectionGeneration) return false;
         getEditable().clear();
         mSent = "";
         return true;
@@ -51,6 +53,13 @@ final class TerminalInputConnection extends BaseInputConnection {
         return !isDiscarded() && getEditable().length() > 0;
     }
 
+    @Override
+    public void closeConnection() {
+        // Finish a still-current composition once, then reject any late calls on this connection.
+        super.closeConnection();
+        mClosed = true;
+    }
+
     @Override
     public boolean setComposingText(CharSequence text, int newCursorPosition) {
         if (TerminalView.TERMINAL_VIEW_KEY_LOGGING_ENABLED) {
@@ -151,7 +160,10 @@ final class TerminalInputConnection extends BaseInputConnection {
             // A new line ends what the IME can edit, so start input again with an empty text.
             for (int i = 0; i < added.length(); i++) {
                 if (added.charAt(i) < ' ') {
-                    mView.post(mView::finishImeInput);
+                    mView.post(() -> {
+                        // A delayed reset belongs to this connection, not one created meanwhile.
+                        if (!isDiscarded()) mView.finishImeInput();
+                    });
                     break;
                 }
             }
diff --git a/terminal-view/src/main/java/com/termux/view/TerminalView.java b/terminal-view/src/main/java/com/termux/view/TerminalView.java
index eadb0749..bccc0f98 100644
--- a/terminal-view/src/main/java/com/termux/view/TerminalView.java
+++ b/terminal-view/src/main/java/com/termux/view/TerminalView.java
@@ -365,7 +365,12 @@ public final class TerminalView extends View {
         // keyboard on Android TV (see https://github.com/termux/termux-app/issues/221).
         outAttrs.imeOptions = EditorInfo.IME_FLAG_NO_FULLSCREEN;
 
-        mInputConnection = new TerminalInputConnection(this, mInputConnectionGeneration);
+        // Android can replace a connection before its delayed close/commit arrives. Only the
+        // newest connection may send text or update the composing preview. Finish a still-current
+        // composition first so switching keyboards does not lose the pending syllable.
+        if (mInputConnection != null) mInputConnection.finishComposingText();
+        mInputConnection = new TerminalInputConnection(this, ++mInputConnectionGeneration);
+        setComposingTextPreview("");
         return mInputConnection;
     }
 
@@ -497,9 +502,8 @@ public final class TerminalView extends View {
         // when it is connected or disconnected, since TermuxActivity handles keyboard config changes.
         if (newConfig.hardKeyboardHidden != mHardKeyboardHidden) {
             mHardKeyboardHidden = newConfig.hardKeyboardHidden;
-            setComposingTextPreview("");
-            InputMethodManager imm = (InputMethodManager) getContext().getSystemService(Context.INPUT_METHOD_SERVICE);
-            if (imm != null) imm.restartInput(this);
+            if (mInputConnection != null) mInputConnection.finishComposingText();
+            discardComposingText();
         }
     }
 
@@ -761,6 +765,7 @@ public final class TerminalView extends View {
         } else if (event.isSystem() && (!mClient.shouldBackButtonBeMappedToEscape() || keyCode != KeyEvent.KEYCODE_BACK)) {
             return super.onKeyDown(keyCode, event);
         } else if (event.getAction() == KeyEvent.ACTION_MULTIPLE && keyCode == KeyEvent.KEYCODE_UNKNOWN) {
+            finishImeInput();
             mTermSession.write(event.getCharacters());
             return true;
         }
-- 
2.43.0

